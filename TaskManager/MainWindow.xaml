<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskManager"
        Height="760"
        Width="1180"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#17191F"
        Foreground="#F1F2F5"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="SidebarBrush" Color="#1D2028"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#222630"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9299A8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6488F5"/>

        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB4C1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2A2F3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL LATERAL -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                Padding="22">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top">

                    <StackPanel Orientation="Horizontal"
                                Margin="2,8,0,42">
                        <Border Width="38"
                                Height="38"
                                CornerRadius="11"
                                Background="#6488F5">
                            <TextBlock Text="T"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <TextBlock Text="TaskManager"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="ORGANIZÁ TU DÍA"
                                       FontSize="9"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="GENERAL"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="12,0,0,10"/>

                    <Button x:Name="BtnPendientes"
                            Style="{StaticResource NavigationButton}"
                            Background="#303B59"
                            Foreground="White"
                            Click="BtnPendientes_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="□" FontSize="19" Width="30"/>
                            <TextBlock Text="Pendientes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCompletadas"
                            Style="{StaticResource NavigationButton}"
                            Click="BtnCompletadas_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="18" Width="30"/>
                            <TextBlock Text="Completadas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="PREFERENCIAS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="12,34,0,10"/>

                    <Button x:Name="BtnConfiguracion"
                            Style="{StaticResource NavigationButton}"
                            Click="BtnConfiguracion_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="17" Width="30"/>
                            <TextBlock Text="Configuración" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        BorderBrush="#343945"
                        BorderThickness="0,1,0,0"
                        Padding="0,18,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="#38496F">
                            <TextBlock Text="U"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="11,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Usuario"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="TaskManager local"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </DockPanel>
        </Border>

        <!-- CONTENIDO -->
        <Grid Grid.Column="1" Margin="38,30,38,30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Grid Grid.Row="0" Margin="0,0,0,30">

                <StackPanel>
                    <TextBlock x:Name="TxtTitulo"
                               Text="Mis tareas"
                               FontSize="29"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="TxtSubtitulo"
                               Text="Organizá tus actividades y mantené todo bajo control."
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel x:Name="PanelAccionesEncabezado"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="BtnNuevaTarea"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnNuevaTarea_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="18" Margin="0,-2,8,0"/>
                            <TextBlock Text="Nueva tarea" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </Grid>

            <!-- RESUMEN -->
            <Grid x:Name="PanelResumen"
                  Grid.Row="1"
                  Margin="0,0,0,28">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="10"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="TAREAS PENDIENTES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="TxtCantidadPendientes"
                                   Text="0"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="10"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="COMPLETADAS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="TxtCantidadCompletadas"
                                   Text="0"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="10"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="TOTAL REGISTRADAS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="TxtCantidadTotal"
                                   Text="0"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- LISTA -->
            <Grid x:Name="PanelLista"
                  Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtTituloLista"
                               Grid.Column="0"
                               Text="Lista de tareas"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="Ordenadas por antigüedad"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>

                        <Button x:Name="BtnBorrarTodasCompletadas"
                                Content="Borrar todas"
                                Click="BtnBorrarTodasCompletadas_Click"
                                Visibility="Collapsed"
                                Padding="12,7"
                                Background="#493039"
                                Foreground="#FFB4B4"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="11"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="ListaTareas">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#222630"
                                        CornerRadius="10"
                                        Padding="18"
                                        Margin="0,0,0,12">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- INDICADOR -->
                                        <Border Grid.Column="0"
                                                Background="#6488F5"
                                                CornerRadius="2"/>

                                        <!-- INFORMACIÓN -->
                                        <StackPanel Grid.Column="2">

                                            <TextBlock Text="{Binding Titulo}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Descripcion}"
                                                       FontSize="12"
                                                       Foreground="#AEB4C1"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding FechaCreacionTexto}"
                                                       FontSize="10"
                                                       Foreground="#9299A8"
                                                       Margin="0,12,0,0"/>

                                            <TextBlock Text="{Binding FechaVencimientoTexto}"
                                                       FontSize="10"
                                                       Foreground="#9299A8"
                                                       Margin="0,4,0,0"/>

                                            <TextBlock Text="{Binding FechaCompletadaTexto}"
                                                       FontSize="10"
                                                       Foreground="#7CCB9B"
                                                       Margin="0,4,0,0"/>

                                        </StackPanel>

                                        <!-- ACCIONES -->
                                        <StackPanel Grid.Column="3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">

                                            <TextBlock FontSize="9"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="PENDIENTE"/>
                                                        <Setter Property="Foreground" Value="#E5B46C"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Completada}" Value="True">
                                                                <Setter Property="Text" Value="COMPLETADA"/>
                                                                <Setter Property="Foreground" Value="#7CCB9B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Content="Completar"
                                                    Tag="{Binding}"
                                                    Click="BtnCompletar_Click"
                                                    Margin="0,15,0,0"
                                                    Padding="10,6"
                                                    Background="#303B59"
                                                    Foreground="#DCE5FF"
                                                    BorderThickness="0"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Completada}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,10,0,0">

                                                <Button Content="Editar"
                                                        Tag="{Binding}"
                                                        Click="BtnEditar_Click"
                                                        Padding="10,6"
                                                        Margin="0,0,6,0"
                                                        Background="#303945"
                                                        Foreground="#DCE5FF"
                                                        BorderThickness="0"
                                                        Cursor="Hand"/>

                                                <Button Content="Eliminar"
                                                        Tag="{Binding}"
                                                        Click="BtnEliminar_Click"
                                                        Padding="10,6"
                                                        Background="#493039"
                                                        Foreground="#FFB4B4"
                                                        BorderThickness="0"
                                                        Cursor="Hand"/>

                                            </StackPanel>

                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

                <TextBlock x:Name="TxtListaVacia"
                           Grid.Row="1"
                           Text="Todavía no hay tareas para mostrar."
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

            </Grid>

            <!-- CONFIGURACIÓN -->
            <Grid x:Name="PanelConfiguracion"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  Visibility="Collapsed">

                <StackPanel MaxWidth="650"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                    <!-- NOTIFICACIONES -->
                    <Border Background="{StaticResource PanelBrush}"
                            CornerRadius="12"
                            Padding="24"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="Recordatorios"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Configurá cómo y cuándo querés recibir avisos sobre tus tareas pendientes."
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,22"/>

                            <CheckBox x:Name="ChkNotificacionesActivas"
                                      Content="Activar notificaciones automáticas"
                                      IsChecked="True"
                                      Foreground="#F1F2F5"
                                      FontSize="13"
                                      FontWeight="Medium"
                                      Cursor="Hand"/>

                            <TextBlock Text="Frecuencia de los recordatorios"
                                       FontSize="12"
                                       Foreground="#AEB4C1"
                                       Margin="0,24,0,9"/>

                            <ComboBox x:Name="CmbIntervaloNotificaciones"
                                      Width="190"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="1"
                                      Padding="9,7"
                                      Background="#303945"
                                      Foreground="#F1F2F5"
                                      BorderBrush="#414957"
                                      SnapsToDevicePixels="True">

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ComboBoxItem}">
                                        <Setter Property="Foreground" Value="#F1F2F5"/>
                                        <Setter Property="Background" Value="#222630"/>
                                        <Setter Property="Padding" Value="9,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                                    <Border x:Name="FondoOpcion"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="FondoOpcion"
                                                                    Property="Background"
                                                                    Value="#303B59"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="FondoOpcion"
                                                                    Property="Background"
                                                                    Value="#303B59"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#777F8F"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                                <ComboBoxItem Content="Cada 15 minutos" Tag="15"/>
                                <ComboBoxItem Content="Cada 30 minutos" Tag="30"/>
                                <ComboBoxItem Content="Cada 45 minutos" Tag="45"/>
                                <ComboBoxItem Content="Cada 60 minutos" Tag="60"/>

                            </ComboBox>

                            <TextBlock Text="Los recordatorios se mostrarán mientras TaskManager esté en ejecución y haya tareas pendientes."
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,20,0,0"/>

                        </StackPanel>
                    </Border>

                    <!-- INICIO CON WINDOWS -->
                    <Border Background="{StaticResource PanelBrush}"
                            CornerRadius="12"
                            Padding="24"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="Inicio de Windows"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Elegí si querés que TaskManager se inicie automáticamente cuando enciendas tu computadora."
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,18"/>

                            <CheckBox x:Name="ChkIniciarConWindows"
                                      Content="Iniciar TaskManager al iniciar Windows"
                                      IsChecked="False"
                                      Foreground="#F1F2F5"
                                      FontSize="13"
                                      FontWeight="Medium"
                                      Cursor="Hand"/>

                        </StackPanel>
                    </Border>

                    <!-- GUARDAR -->
                    <Border Background="{StaticResource PanelBrush}"
                            CornerRadius="12"
                            Padding="24">

                        <StackPanel>

                            <TextBlock Text="Guardar preferencias"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Los cambios se conservarán aunque cierres y vuelvas a abrir el programa."
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,18"/>

                            <Button Content="Guardar configuración"
                                    Click="BtnGuardarConfiguracion_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"/>

                            <TextBlock x:Name="TxtEstadoConfiguracion"
                                       FontSize="12"
                                       Foreground="#7CCB9B"
                                       Margin="0,14,0,0"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
